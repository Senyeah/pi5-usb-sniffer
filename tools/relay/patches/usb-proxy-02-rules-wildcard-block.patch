+// A rule field of -1 matches any value.
+static bool control_rule_matches(const Json::Value &rule, const struct usb_ctrlrequest &ctrl) {
+	auto mismatch = [&rule](const char *key, int actual) {
+		int want = rule[key].asInt();
+		return want != -1 && actual != hexToDecimal(want);
+	};
+	return !(mismatch("bRequestType", ctrl.bRequestType) ||
+		 mismatch("bRequest", ctrl.bRequest) ||
+		 mismatch("wValue", ctrl.wValue) ||
+		 mismatch("wIndex", ctrl.wIndex) ||
+		 mismatch("wLength", ctrl.wLength));
+}
+
+// Ignore and stall rules are checked before a request is forwarded, so the device never sees it.
+int control_block_flags(const struct usb_ctrlrequest &ctrl) {
+	for (const char *type : {"ignore", "stall"}) {
+		for (unsigned int j = 0; j < injection_config["control"][type].size(); j++) {
+			Json::Value rule = injection_config["control"][type][j];
+			if (!rule["enable"].asBool() || !control_rule_matches(rule, ctrl))
+				continue;
+			printf("Matched injection rule: %s, index: %d (bRequestType 0x%02x bRequest 0x%02x wValue 0x%04x wIndex 0x%04x wLength %u)\n",
+			       type, j, ctrl.bRequestType, ctrl.bRequest, ctrl.wValue, ctrl.wIndex, ctrl.wLength);
+			return strcmp(type, "ignore") == 0 ? USB_INJECTION_FLAG_IGNORE : USB_INJECTION_FLAG_STALL;
+		}
+	}
+	return USB_INJECTION_FLAG_NONE;
+}
