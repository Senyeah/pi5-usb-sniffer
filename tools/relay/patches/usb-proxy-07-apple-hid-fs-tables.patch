+					       {0x13,95},{0x14,193},{0x15,255}};
+static const hid_report_size apple_fs_in[]  = {{0x01,12},{0x02,14},{0x03,20},{0x04,63}};
+static const hid_report_size apple_fs_out[] = {{0x05,8},{0x06,10},{0x07,14},{0x08,20},{0x09,63}};
+static const unsigned char apple_fs_hid_report_desc[96] = {
