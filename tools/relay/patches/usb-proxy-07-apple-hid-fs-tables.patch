+// Apple iAP over HID: one report table per bus speed. The count includes the link control byte (LCB)
+// but not the report ID. LCB bit 0 = continuation, bit 1 = more to follow. A receiver joins the
+// fragments end to end, so only the last fragment of a packet may carry padding.
+#include <vector>
+struct hid_report_size { uint8_t id; uint16_t count; };
+static const hid_report_size apple_hs_in[]  = {{0x01,5},{0x02,9},{0x03,13},{0x04,17},{0x05,25},{0x06,49},
+					       {0x07,95},{0x08,193},{0x09,257},{0x0a,385},{0x0b,513},{0x0c,767}};
