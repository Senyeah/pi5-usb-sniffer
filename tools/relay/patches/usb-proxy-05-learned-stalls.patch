--- a/proxy.cpp
+++ b/proxy.cpp
@@ -25,6 +25,15 @@ static bool host_link_is_full_speed() {
 	return fs;
 }
 
+// OUT requests with data that the device stalled. Keyed by the whole setup packet.
+#include <set>
+static std::set<uint64_t> stalled_out_requests;
+
+static uint64_t setup_key(const struct usb_ctrlrequest &c) {
+	return ((uint64_t)c.bRequestType << 56) | ((uint64_t)c.bRequest << 48) |
+	       ((uint64_t)c.wValue << 32) | ((uint64_t)c.wIndex << 16) | c.wLength;
+}
+
 static bool serve_other_speed() {
 	return device_speed == USB_SPEED_HIGH && host_link_is_full_speed();
 }
@@ -1450,6 +1459,14 @@ void ep0_loop(int fd) {
 					}
 				}
 
+				if (event.ctrl.wLength > 0 && stalled_out_requests.count(setup_key(event.ctrl))) {
+					printf("ep0: device stalled this OUT request before, stalling host (bRequestType 0x%02x bRequest 0x%02x wValue 0x%04x wIndex 0x%04x wLength %u)\n",
+					       event.ctrl.bRequestType, event.ctrl.bRequest, event.ctrl.wValue, event.ctrl.wIndex, event.ctrl.wLength);
+					delete[] control_data;
+					usb_raw_ep0_stall(fd);
+					continue;
+				}
+
 				if (event.ctrl.wLength == 0) {
 					// For 0-length request, we can ack or stall the request via
 					// Raw Gadget, depending on what the proxied device does.
@@ -1496,6 +1513,10 @@ void ep0_loop(int fd) {
 					if (result == 0) {
 						printf("ep0: transferred %d bytes (out)\n", rv);
 					}
+					else if (result == -1 && stalled_out_requests.insert(setup_key(event.ctrl)).second) {
+						printf("ep0: device stalled OUT request with data; the host was already acked. Future identical requests get a stall (bRequestType 0x%02x bRequest 0x%02x wValue 0x%04x wIndex 0x%04x wLength %u)\n",
+						       event.ctrl.bRequestType, event.ctrl.bRequest, event.ctrl.wValue, event.ctrl.wIndex, event.ctrl.wLength);
+					}
 				}
 			}
 		}
