 #include "host-raw-gadget.h"
 #include "device-libusb.h"
 #include "misc.h"
+#include <fstream>
+#include <glob.h>
+
+extern enum usb_device_speed device_speed;
+
+// A full-speed host must see a high-speed device's other-speed descriptors.
+static bool host_link_is_full_speed() {
+	glob_t g;
+	bool fs = false;
+	if (glob("/sys/class/udc/*/current_speed", 0, NULL, &g) == 0 && g.gl_pathc > 0) {
+		std::ifstream f(g.gl_pathv[0]);
+		std::string speed;
+		f >> speed;
+		fs = (speed == "full-speed");
+	}
+	globfree(&g);
+	return fs;
+}
+
+static bool serve_other_speed() {
+	return device_speed == USB_SPEED_HIGH && host_link_is_full_speed();
+}
+
+// (config index, interface, alt, device endpoint) -> (wMaxPacketSize, bInterval) at full speed
+static std::map<uint32_t, std::pair<uint16_t, uint8_t>> fs_endpoint_params;
+
+static uint32_t fs_key(uint8_t config_index, uint8_t interface, uint8_t alt, uint8_t ep) {
+	return ((uint32_t)config_index << 24) | ((uint32_t)interface << 16) | ((uint32_t)alt << 8) | ep;
+}
+
+void fetch_other_speed_descriptors() {
+	for (int i = 0; i < device_device_desc.bNumConfigurations; i++) {
+		unsigned char buf[1024];
+		unsigned char *p = buf;
+		int nbytes = 0;
+		struct usb_ctrlrequest req = {
+			.bRequestType = USB_DIR_IN,
+			.bRequest = USB_REQ_GET_DESCRIPTOR,
+			.wValue = (__le16)((USB_DT_OTHER_SPEED_CONFIG << 8) | i),
+			.wIndex = 0,
+			.wLength = sizeof(buf),
+		};
+		if (control_request(&req, &nbytes, &p, USB_REQUEST_TIMEOUT) != 0 || nbytes < 9) {
+			printf("No other-speed descriptor for config index %d\n", i);
+			continue;
+		}
+		uint8_t iface = 0, alt = 0;
+		for (int off = 0; off + 2 <= nbytes; ) {
+			uint8_t len = buf[off], type = buf[off + 1];
+			if (len < 2 || off + len > nbytes)
+				break;
+			if (type == USB_DT_INTERFACE && len >= 4) {
+				iface = buf[off + 2];
+				alt = buf[off + 3];
+			}
+			if (type == USB_DT_ENDPOINT && len >= 7) {
+				uint16_t maxp = buf[off + 4] | (buf[off + 5] << 8);
+				fs_endpoint_params[fs_key(i, iface, alt, buf[off + 2])] = {maxp, buf[off + 6]};
+			}
+			off += len;
+		}
+		printf("Other-speed descriptor for config index %d: %d bytes\n", i, nbytes);
+	}
+}
 
