#!/usr/bin/env python3
# Press a car stereo button on the Pi 3 sink. Usage: stereo playpause | next
# It waits until the player has changed (up to 6 s: the phone is behind Bluetooth), then prints the state.
import json, subprocess, sys, time

BUTTONS = {"playpause": "toggle", "play-pause": "toggle", "pp": "toggle", "next": "stereo-next", "n": "stereo-next"}


def ctl(*words):
    return subprocess.run(["iap-sink", "ctl", *words], capture_output=True, text=True).stdout.strip()


def status():
    out = ctl("status")
    return json.loads(out) if out.startswith("{") else None


def line(d):
    ms = lambda v: "%d:%02d" % (v // 60000, v // 1000 % 60)
    who = " - ".join(x for x in (d["title"], d["artist"]) if x)
    return "%s | track %s/%s | %s | %s/%s" % (d["play_state"], d["track"], d["num_tracks"], who or "(no title)", ms(d["position_ms"]), ms(d["length_ms"]))


if len(sys.argv) != 2 or sys.argv[1] not in BUTTONS:
    sys.exit("Usage: stereo playpause | next")
cmd = BUTTONS[sys.argv[1]]

before = status()
if before is None:
    sys.exit(ctl("status") or "iap-sink is not running")
ctl(cmd)

deadline = time.time() + 6
now = before
while time.time() < deadline:
    time.sleep(0.5)
    now = status() or now
    if cmd == "toggle" and now["play_state"] != before["play_state"]:
        break
    if cmd == "stereo-next" and (now["track"] != before["track"] or now["title"] != before["title"]):
        time.sleep(0.8)  # the title and artist follow the index
        now = status() or now
        break
print(line(now) + ("" if now != before else "   (no change yet)"))
