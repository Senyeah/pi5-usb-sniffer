[Unit]
Description=Play the phone's Bluetooth audio into the iPod USB gadget
After=ipod-gadget.service bluealsa.service
Requires=ipod-gadget.service bluealsa.service
BindsTo=ipod-gadget.service

[Service]
EnvironmentFile=-/etc/ipod-bridge.conf
ExecStart=/usr/local/sbin/ipod-audio
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
